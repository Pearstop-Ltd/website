# Groq API — powers the free UNSPSC code lookup tool (app/api/unspsc-lookup)
GROQ_API_KEY=

# Cloudflare Turnstile — bot protection for the lookup tool.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile (free).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is exposed to the browser (renders the widget);
# TURNSTILE_SECRET_KEY stays server-side (verifies the token).
# Without these set, the lookup tool's widget shows a "not configured" notice
# and the server-side check fails open (allows requests) with a console warning
# — fine for local dev, not something to ship to production unconfigured.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel KV — per-IP daily rate limit (5/day) for the lookup tool.
# Enable "KV" storage on this project in the Vercel dashboard (Storage tab);
# it auto-injects these two vars there. Without them, rate limiting fails
# open (allows all requests) with a console warning — same caveat as above.
KV_REST_API_URL=
KV_REST_API_TOKEN=
