# Groq API — powers the free UNSPSC code lookup tool (app/api/unspsc-lookup)
GROQ_API_KEY=

# Google Gemini API — powers scripts/translate.js (npm run translate / prebuild),
# which auto-translates messages/en.json, content/blog/en/*.mdx, and blog post
# faqItems into nl/fr/de. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google reCAPTCHA v2 (checkbox) — bot protection for the lookup tool.
# Create/find a key at https://www.google.com/recaptcha/admin — the domain the
# key is registered against must include the domain this site is served from
# (add it to an existing key's domain list, or create a new key).
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY is exposed to the browser (renders the widget);
# RECAPTCHA_SECRET_KEY stays server-side (verifies the token).
# Without these set, the lookup tool's widget shows a "not configured" notice
# and the server-side check fails open (allows requests) with a console warning
# — fine for local dev, not something to ship to production unconfigured.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Vercel KV — per-IP daily rate limit (5/day) for the lookup tool.
# Enable "KV" storage on this project in the Vercel dashboard (Storage tab);
# it auto-injects these two vars there. Without them, rate limiting fails
# open (allows all requests) with a console warning — same caveat as above.
KV_REST_API_URL=
KV_REST_API_TOKEN=
